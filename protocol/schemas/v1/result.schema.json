{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semantifx.local/protocol/v1/result.schema.json",
  "title": "SemantiFX analysis result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "type", "request_id", "status", "backend", "elapsed_ms"],
  "properties": {
    "protocol_version": { "const": "1" },
    "type": { "const": "analysis_result" },
    "request_id": { "type": ["string", "null"] },
    "status": { "enum": ["ok", "error"] },
    "backend": { "type": ["string", "null"] },
    "elapsed_ms": { "type": "number", "minimum": 0 },
    "parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["effect", "name", "value", "unit"],
        "properties": {
          "effect": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "value": { "type": "number" },
          "unit": { "enum": ["dB", "Hz", "ratio", "unitless"] }
        }
      }
    },
    "metrics": { "type": "object" },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "remediation"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "remediation": { "type": "array", "items": { "type": "string" } },
        "details": { "type": "object" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "ok" } } },
      "then": { "required": ["parameters", "metrics", "warnings"] },
      "else": { "required": ["error"] }
    }
  ]
}
