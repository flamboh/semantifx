{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semantifx.local/protocol/result.schema.json",
  "title": "SemantiFX protocol result",
  "type": "object",
  "oneOf": [
    {
      "$ref": "#/$defs/analysisResult"
    },
    {
      "$ref": "#/$defs/assemblyResult"
    }
  ],
  "$defs": {
    "analysisResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "request_id",
        "status",
        "backend",
        "elapsed_ms"
      ],
      "properties": {
        "type": {
          "const": "analysis_result"
        },
        "request_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "ok",
            "error"
          ]
        },
        "backend": {
          "type": [
            "string",
            "null"
          ]
        },
        "elapsed_ms": {
          "type": "number",
          "minimum": 0
        },
        "chain_order": {
          "type": "array",
          "minItems": 0,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "parameters": {
          "type": "array",
          "minItems": 0,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/parameterEntry"
          }
        },
        "metrics": {
          "type": "object"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "error": {
          "$ref": "#/$defs/error"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "ok"
              }
            }
          },
          "then": {
            "required": [
              "chain_order",
              "parameters",
              "metrics",
              "warnings"
            ]
          },
          "else": {
            "required": [
              "error"
            ]
          }
        }
      ]
    },
    "assemblyResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "request_id",
        "status",
        "backend",
        "elapsed_ms"
      ],
      "properties": {
        "type": {
          "const": "assembly_result"
        },
        "request_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "ok",
            "error"
          ]
        },
        "backend": {
          "type": [
            "string",
            "null"
          ]
        },
        "elapsed_ms": {
          "type": "number",
          "minimum": 0
        },
        "chain": {
          "$ref": "#/$defs/chain"
        },
        "judgments": {
          "$ref": "#/$defs/judgments"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "error": {
          "$ref": "#/$defs/error"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "ok"
              }
            }
          },
          "then": {
            "required": [
              "chain",
              "judgments",
              "warnings"
            ]
          },
          "else": {
            "required": [
              "error"
            ]
          }
        }
      ]
    },
    "chain": {
      "type": "array",
      "minItems": 0,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/eqChainItem"
          },
          {
            "$ref": "#/$defs/distortionChainItem"
          },
          {
            "$ref": "#/$defs/compressorChainItem"
          },
          {
            "$ref": "#/$defs/reverbChainItem"
          }
        ]
      }
    },
    "eqChainItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instance_id",
        "effect_type",
        "parameters"
      ],
      "properties": {
        "instance_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "effect_type": {
          "const": "eq"
        },
        "parameters": {
          "$ref": "#/$defs/eqParameters"
        }
      }
    },
    "eqParameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "low_shelf_gain_db",
        "low_shelf_cutoff_freq",
        "low_shelf_q_factor",
        "band0_gain_db",
        "band0_cutoff_freq",
        "band0_q_factor",
        "band1_gain_db",
        "band1_cutoff_freq",
        "band1_q_factor",
        "band2_gain_db",
        "band2_cutoff_freq",
        "band2_q_factor",
        "band3_gain_db",
        "band3_cutoff_freq",
        "band3_q_factor",
        "high_shelf_gain_db",
        "high_shelf_cutoff_freq",
        "high_shelf_q_factor"
      ],
      "properties": {
        "low_shelf_gain_db": {
          "type": "number",
          "minimum": -20.0,
          "maximum": 20.0
        },
        "low_shelf_cutoff_freq": {
          "type": "number",
          "minimum": 20.0,
          "maximum": 2000.0
        },
        "low_shelf_q_factor": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 6.0
        },
        "band0_gain_db": {
          "type": "number",
          "minimum": -20.0,
          "maximum": 20.0
        },
        "band0_cutoff_freq": {
          "type": "number",
          "minimum": 80.0,
          "maximum": 2000.0
        },
        "band0_q_factor": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 6.0
        },
        "band1_gain_db": {
          "type": "number",
          "minimum": -20.0,
          "maximum": 20.0
        },
        "band1_cutoff_freq": {
          "type": "number",
          "minimum": 2000.0,
          "maximum": 8000.0
        },
        "band1_q_factor": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 6.0
        },
        "band2_gain_db": {
          "type": "number",
          "minimum": -20.0,
          "maximum": 20.0
        },
        "band2_cutoff_freq": {
          "type": "number",
          "minimum": 8000.0,
          "maximum": 12000.0
        },
        "band2_q_factor": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 6.0
        },
        "band3_gain_db": {
          "type": "number",
          "minimum": -20.0,
          "maximum": 20.0
        },
        "band3_cutoff_freq": {
          "type": "number",
          "minimum": 12000.0,
          "maximum": 21050.0
        },
        "band3_q_factor": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 6.0
        },
        "high_shelf_gain_db": {
          "type": "number",
          "minimum": -20.0,
          "maximum": 20.0
        },
        "high_shelf_cutoff_freq": {
          "type": "number",
          "minimum": 4000.0,
          "maximum": 21050.0
        },
        "high_shelf_q_factor": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 6.0
        }
      }
    },
    "distortionChainItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instance_id",
        "effect_type",
        "parameters"
      ],
      "properties": {
        "instance_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "effect_type": {
          "const": "distortion"
        },
        "parameters": {
          "$ref": "#/$defs/distortionParameters"
        }
      }
    },
    "distortionParameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "drive_db",
        "character",
        "tone_db",
        "mix"
      ],
      "properties": {
        "drive_db": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 48.0
        },
        "character": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "tone_db": {
          "type": "number",
          "minimum": -12.0,
          "maximum": 12.0
        },
        "mix": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        }
      }
    },
    "compressorChainItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instance_id",
        "effect_type",
        "parameters"
      ],
      "properties": {
        "instance_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "effect_type": {
          "const": "compressor"
        },
        "parameters": {
          "$ref": "#/$defs/compressorParameters"
        }
      }
    },
    "compressorParameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "threshold_db",
        "ratio",
        "attack_ms",
        "knee_db",
        "makeup_gain_db"
      ],
      "properties": {
        "threshold_db": {
          "type": "number",
          "minimum": -60.0,
          "maximum": 0.0
        },
        "ratio": {
          "type": "number",
          "minimum": 1.0,
          "maximum": 20.0
        },
        "attack_ms": {
          "type": "number",
          "minimum": 5.0,
          "maximum": 100.0
        },
        "knee_db": {
          "type": "number",
          "minimum": 1.0,
          "maximum": 12.0
        },
        "makeup_gain_db": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 12.0
        }
      }
    },
    "reverbChainItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instance_id",
        "effect_type",
        "parameters"
      ],
      "properties": {
        "instance_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "effect_type": {
          "const": "reverb"
        },
        "parameters": {
          "$ref": "#/$defs/reverbParameters"
        }
      }
    },
    "reverbParameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decay",
        "damping",
        "mix"
      ],
      "properties": {
        "decay": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "damping": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "mix": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        }
      }
    },
    "eqParameterEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "effect_instance_id",
        "effect",
        "name",
        "value",
        "unit"
      ],
      "properties": {
        "effect_instance_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "effect": {
          "enum": [
            "eq",
            "distortion",
            "compressor",
            "reverb"
          ]
        },
        "name": {
          "enum": [
            "low_shelf_gain_db",
            "low_shelf_cutoff_freq",
            "low_shelf_q_factor",
            "band0_gain_db",
            "band0_cutoff_freq",
            "band0_q_factor",
            "band1_gain_db",
            "band1_cutoff_freq",
            "band1_q_factor",
            "band2_gain_db",
            "band2_cutoff_freq",
            "band2_q_factor",
            "band3_gain_db",
            "band3_cutoff_freq",
            "band3_q_factor",
            "high_shelf_gain_db",
            "high_shelf_cutoff_freq",
            "high_shelf_q_factor"
          ]
        },
        "value": {
          "type": "number"
        },
        "unit": {
          "enum": [
            "Hz",
            "dB",
            "ratio"
          ]
        }
      },
      "allOf": [
        {
          "properties": {
            "effect": {
              "const": "eq"
            }
          }
        },
        {
          "oneOf": [
            {
              "properties": {
                "name": {
                  "const": "low_shelf_gain_db"
                },
                "unit": {
                  "const": "dB"
                }
              }
            },
            {
              "properties": {
                "name": {
                  "const": "low_shelf_cutoff_freq"
                },
                "unit": {
                  "const": "Hz"
                }
              }
            },
            {
              "properties": {
                "name": {
                  "const": "low_shelf_q_factor"
                },
                "unit": {
                  "const": "ratio"
                }
              }
            },
            {
              "properties": {
                "name": {
                  "const": "band0_gain_db"
                },
                "unit": {
                  "const": "dB"
                }
              }
            },
            {
              "properties": {
                "name": {
                  "const": "band0_cutoff_freq"
                },
                "unit": {
                  "const": "Hz"
                }
              }
            },
            {
              "properties": {
                "name": {
                  "const": "band0_q_factor"
                },
                "unit": {
                  "const": "ratio"
                }
              }
            },
            {
              "properties": {
                "name": {
                  "const": "band1_gain_db"
                },
                "unit": {
                  "const": "dB"
                }
              }
            },
            {
              "properties": {
                "name": {
                  "const": "band1_cutoff_freq"
                },
                "unit": {
                  "const": "Hz"
                }
              }
            },
            {
              "properties": {
                "name": {
                  "const": "band1_q_factor"
                },
                "unit": {
                  "const": "ratio"
                }
              }
            },
            {
              "properties": {
                "name": {
                  "const": "band2_gain_db"
                },
                "unit": {
                  "const": "dB"
                }
              }
            },
            {
              "properties": {
                "name": {
                  "const": "band2_cutoff_freq"
                },
                "unit": {
                  "const": "Hz"
                }
              }
            },
            {
              "properties": {
                "name": {
                  "const": "band2_q_factor"
                },
                "unit": {
                  "const": "ratio"
                }
              }
            },
            {
              "properties": {
                "name": {
                  "const": "band3_gain_db"
                },
                "unit": {
                  "const": "dB"
                }
              }
            },
            {
              "properties": {
                "name": {
                  "const": "band3_cutoff_freq"
                },
                "unit": {
                  "const": "Hz"
                }
              }
            },
            {
              "properties": {
                "name": {
                  "const": "band3_q_factor"
                },
                "unit": {
                  "const": "ratio"
                }
              }
            },
            {
              "properties": {
                "name": {
                  "const": "high_shelf_gain_db"
                },
                "unit": {
                  "const": "dB"
                }
              }
            },
            {
              "properties": {
                "name": {
                  "const": "high_shelf_cutoff_freq"
                },
                "unit": {
                  "const": "Hz"
                }
              }
            },
            {
              "properties": {
                "name": {
                  "const": "high_shelf_q_factor"
                },
                "unit": {
                  "const": "ratio"
                }
              }
            }
          ]
        }
      ]
    },
    "distortionParameterEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "effect_instance_id",
        "effect",
        "name",
        "value",
        "unit"
      ],
      "properties": {
        "effect_instance_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "effect": {
          "enum": [
            "eq",
            "distortion",
            "compressor",
            "reverb"
          ]
        },
        "name": {
          "enum": [
            "drive_db",
            "character",
            "tone_db",
            "mix"
          ]
        },
        "value": {
          "type": "number"
        },
        "unit": {
          "enum": [
            "dB",
            "ratio"
          ]
        }
      },
      "allOf": [
        {
          "properties": {
            "effect": {
              "const": "distortion"
            }
          }
        },
        {
          "oneOf": [
            {
              "properties": {
                "name": {
                  "const": "drive_db"
                },
                "unit": {
                  "const": "dB"
                }
              }
            },
            {
              "properties": {
