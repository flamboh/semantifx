            "attack_ms",
            "knee_db",
            "makeup_gain_db"
          ]
        },
        "value": {
          "type": "number"
        },
        "unit": {
          "enum": [
            "dB",
            "ms",
            "ratio"
          ]
        }
      },
      "allOf": [
        {
          "properties": {
            "effect": {
              "const": "compressor"
            }
          }
        },
        {
          "oneOf": [
            {
              "properties": {
                "name": {
                  "const": "threshold_db"
                },
                "unit": {
                  "const": "dB"
                }
              }
            },
            {
              "properties": {
                "name": {
                  "const": "ratio"
                },
                "unit": {
                  "const": "ratio"
                }
              }
            },
            {
              "properties": {
                "name": {
                  "const": "attack_ms"
                },
                "unit": {
                  "const": "ms"
                }
              }
            },
            {
              "properties": {
                "name": {
                  "const": "knee_db"
                },
                "unit": {
                  "const": "dB"
                }
              }
            },
            {
              "properties": {
                "name": {
                  "const": "makeup_gain_db"
                },
                "unit": {
                  "const": "dB"
                }
              }
            }
          ]
        }
      ]
    },
    "reverbParameterEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "effect_instance_id",
        "effect",
        "name",
        "value",
        "unit"
      ],
      "properties": {
        "effect_instance_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "effect": {
          "enum": [
            "eq",
            "distortion",
            "compressor",
            "reverb"
          ]
        },
        "name": {
          "enum": [
            "decay",
            "damping",
            "mix"
          ]
        },
        "value": {
          "type": "number"
        },
        "unit": {
          "enum": [
            "ratio"
          ]
        }
      },
      "allOf": [
        {
          "properties": {
            "effect": {
              "const": "reverb"
            }
          }
        },
        {
          "oneOf": [
            {
              "properties": {
                "name": {
                  "const": "decay"
                },
                "unit": {
                  "const": "ratio"
                }
              }
            },
            {
              "properties": {
                "name": {
                  "const": "damping"
                },
                "unit": {
                  "const": "ratio"
                }
              }
            },
            {
              "properties": {
                "name": {
                  "const": "mix"
                },
                "unit": {
                  "const": "ratio"
                }
              }
            }
          ]
        }
      ]
    },
    "parameterEntry": {
      "oneOf": [
        {
          "$ref": "#/$defs/eqParameterEntry"
        },
        {
          "$ref": "#/$defs/distortionParameterEntry"
        },
        {
          "$ref": "#/$defs/compressorParameterEntry"
        },
        {
          "$ref": "#/$defs/reverbParameterEntry"
        }
      ]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "remediation"
      ],
      "properties": {
        "code": {
          "enum": [
            "invalid_json",
            "invalid_request",
            "backend_unavailable",
            "internal_error",
            "clap_dependency_unavailable",
            "audio_not_found",
            "clap_execution_failed",
            "assembly_unavailable"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "remediation": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "details": {
          "type": "object"
        }
      }
    },
    "judgments": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selection",
        "no_change",
        "order"
      ],
      "properties": {
        "selection": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "no_change": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "order": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    }
  }
}
