                  "const": "mix"
                },
                "unit": {
                  "const": "ratio"
                }
              }
            }
          ]
        }
      ]
    },
    "compressorParameterEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "effect_instance_id",
        "effect",
        "name",
        "value",
        "unit"
      ],
      "properties": {
        "effect_instance_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "effect": {
          "enum": [
            "eq",
            "distortion",
