#!/bin/sh
set -eu

repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
python=${SEMANTIFX_PYTHON:-"$repo_dir/inference/.venv/bin/python"}
audio=${1:?"usage: scripts/analyze AUDIO_FILE [PROMPT [ITERATIONS [OUTPUT [PROGRESS_FILE]]]]"}
prompt=${2:-"warm, but keep it clear"}
iterations=${3:-600}
output=${4:-/tmp/semantifx-analysis.json}
progress=${5:-}

if [ ! -x "$python" ]; then
  echo "SemantiFX Python environment not found: $python" >&2
  echo "Set SEMANTIFX_PYTHON to a working interpreter." >&2
  exit 1
fi

set -- \
  --backend clap \
  --audio "$audio" \
  --prompt "$prompt" \
  --request-id semantifx-analysis \
  --iterations "$iterations" \
  --random-seed 0 \
  --parameter-initialization current \
  --deterministic-metadata
if [ -n "$progress" ]; then
  set -- "$@" --progress-file "$progress"
fi

PYTHONPATH="$repo_dir/inference/src" "$python" \
  -m semantifx_inference.cli analyze "$@" > "$output"

echo "Analysis result: $output"
echo "Import it with the plugin's 'Import Analysis…' button."
