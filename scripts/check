#!/bin/sh
set -eu

repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

echo "== Inference tests =="
(cd "$repo_dir/inference" && PYTHONPATH=src python3 -m unittest discover -s tests -v)

echo "== Prototype syntax =="
node --check "$repo_dir/prototype/app.js"

echo "== Plugin build and tests =="
if [ ! -f "$repo_dir/plugin/build/CMakeCache.txt" ]; then
  cmake -S "$repo_dir/plugin" -B "$repo_dir/plugin/build" -DCMAKE_BUILD_TYPE=Debug
fi
cmake --build "$repo_dir/plugin/build" --config Debug --parallel 4
ctest --test-dir "$repo_dir/plugin/build" --output-on-failure -C Debug

echo "All SemantiFX checks passed."
