#!/bin/sh
set -eu

repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
python=${SEMANTIFX_PYTHON:-"$repo_dir/inference/.venv/bin/python"}
spool_dir=${1:?"usage: scripts/worker SPOOL_DIRECTORY"}

if [ ! -x "$python" ]; then
  echo "SemantiFX Python environment not found: $python" >&2
  exit 1
fi

exec env PYTHONPATH="$repo_dir/inference/src" "$python" \
  -m semantifx_inference.spool_worker \
  --directory "$spool_dir" \
  --default-backend clap
